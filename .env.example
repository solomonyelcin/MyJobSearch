# Server configuration (set these as environment variables on Render)
PORT=3000
CORS_ORIGIN=*

# AI features. Without a key the app still works with rule-based resume parsing and job ranking.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max AI requests per visitor per hour (protects your API bill)
AI_REQUESTS_PER_HOUR=40

# Optional: Adzuna adds on-site job listings (free key at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jobs are searched ONLY in this place unless the user changes it in the app
DEFAULT_LOCATION=Chennai

# Optional: add company career feeds without code changes (JSON array).
# ats is one of: greenhouse | lever | smartrecruiters | workday | amazon
# COMPANIES_EXTRA=[{"name":"Acme","ats":"greenhouse","slug":"acme"},{"name":"Foo","ats":"workday","slug":"foo","host":"foo.wd1.myworkdayjobs.com","site":"Careers"}]

# Optional: Jooble aggregates many Indian job boards (free key: jooble.org/api/about)
JOOBLE_API_KEY=
